---
import Layout from '../layouts/Layout.astro';
import AxolotlPet from '../components/AxolotlPet'; // The new component
---

<Layout title="My Axolotl Aquarium">
  <main>
    {/* We use client:load so the heart animations and buttons work immediately */}
    <AxolotlPet client:load />
  </main>
</Layout>

<style>
  main {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
</style>